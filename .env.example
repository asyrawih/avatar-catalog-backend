# Salin ke .env lalu sesuaikan. Server membaca environment langsung, jadi
# muat file ini lewat shell atau docker compose.

APP_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Data contoh untuk mode in-memory (diabaikan kalau DATABASE_URL diisi —
# isi awal Postgres datang dari skrip di db/init).
SEED_DATA=true

# Kosong = penyimpanan in-memory. Diisi = Postgres.
# docker compose mengisinya otomatis; nilai ini untuk `go run` dari host.
DATABASE_URL=
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=10s

# Kosong = tanpa cache. Diisi = cache baca + penyimpan kunci idempotensi.
REDIS_URL=
CACHE_TTL=1m
CACHE_PREFIX=avatar-catalog

# Kosong = autentikasi belum aktif, semua request diterima.
# Isi dengan token layanan dipisah koma untuk mewajibkan Bearer token.
AUTH_TOKENS=

IDEMPOTENCY_TTL=24h
SHUTDOWN_TIMEOUT=10s

# --- Postgres (docker compose) ---
# Dipakai service db dan diteruskan ke api sebagai DATABASE_URL. Lapisan
# penyimpanan masih in-memory, jadi api belum benar-benar memakainya.
POSTGRES_DB=avatar_catalog
POSTGRES_USER=avatar
POSTGRES_PASSWORD=avatar_dev_password
POSTGRES_PORT=5432

# --- Redis (docker compose) ---
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# Port Adminer, hanya aktif dengan --profile tools.
ADMINER_PORT=8081

# --- Caddy (reverse proxy) ---
# ":80" = lokal, HTTP saja. Isi domain (mis. api.contoh.com) supaya Caddy
# mengambil sertifikat Let's Encrypt sendiri — domain harus sudah mengarah
# ke server ini dan port 80/443 terbuka.
SITE_ADDRESS=:80
ACME_EMAIL=hanan@kelasmalam.app
HTTP_PORT=80
HTTPS_PORT=443

# Dipakai docker-compose.server.yml: network milik Caddy yang sudah jalan di
# server. Diabaikan saat compose dijalankan tanpa override itu.
EDGE_NETWORK=root_kaneo

# --- Khusus .env di server, jangan diaktifkan di lokal ---
# Tanpa baris ini, `docker compose up -d` polos me-recreate api memakai
# docker-compose.yml saja. api lepas dari network Caddy, alias
# avatar-catalog-api hilang, dan semua request publik jadi 502. Dengan baris
# ini setiap perintah compose otomatis ikut override.
# Di lokal override itu justru gagal: network root_kaneo tidak ada.
# COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
